# Copy to .env (git-ignored). No secrets here: credentials come from
# `gcloud auth application-default login` (Application Default Credentials).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=storegear-prod-ag26
# Model calls use the EU jurisdictional endpoint (ADR-001 addendum): 3.x models aren't served in europe-west1.
GOOGLE_CLOUD_LOCATION=eu
STOREGEAR_MODEL=gemini-3.8-flash
