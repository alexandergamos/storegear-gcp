# Copy to .env (git-ignored). No secrets here: credentials come from
# `gcloud auth application-default login` (Application Default Credentials).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=storegear-prod-ag26
GOOGLE_CLOUD_LOCATION=europe-west1
# Model under test. If it isn't served in europe-west1, SMO-9 records which one is (ADR-001 caveat).
STOREGEAR_MODEL=gemini-2.5-flash
