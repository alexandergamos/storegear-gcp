# Copy to .env (git-ignored). No secrets: credentials come from ADC.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=storegear-prod-ag26
GOOGLE_CLOUD_LOCATION=eu
STOREGEAR_MODEL=gemini-3.8-flash
STOREGEAR_THINKING=low
# Local runs: act AS the agent's service account (exact permissions: DB read-only, Sheet viewer)
STOREGEAR_IMPERSONATE_SA=sg-agent@storegear-prod-ag26.iam.gserviceaccount.com
